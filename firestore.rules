rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if the user is a member of the given family
    function isFamilyMember(familyId) {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/families/$(familyId)) &&
             request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.members;
    }

    // Helper function to check if the user is a parent (defaults to true if profile not found or role not defined)
    function isParent(userId) {
      return !exists(/databases/$(database)/documents/users/$(userId)) || 
             get(/databases/$(database)/documents/users/$(userId)).data.get('role', 'parent') == 'parent';
    }

    // Helper function to check if the user is a parent member of the family
    function isParentMember(familyId) {
      return isFamilyMember(familyId) && isParent(request.auth.uid);
    }

    // Users Collection - Read allowed if authenticated, write only own profile
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Families Collection - Member validation
    match /families/{familyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.members;
      allow update: if isAuthenticated() && (
        // Case 1: User is already a member
        (request.auth.uid in resource.data.members) ||
        // Case 2: User is joining by adding their UID to members
        (request.auth.uid in request.resource.data.members)
      );
      allow delete: if isAuthenticated() && request.auth.uid in resource.data.members && isParent(request.auth.uid);
    }

    // Transactions Collection - Member cross-reference validation (Parents only can write/delete)
    match /transactions/{transactionId} {
      allow read: if isAuthenticated() && isFamilyMember(resource.data.familyId);
      allow create: if isAuthenticated() && isParentMember(request.resource.data.familyId);
      allow update: if isAuthenticated() && isParentMember(resource.data.familyId) && isParentMember(request.resource.data.familyId);
      allow delete: if isAuthenticated() && isParentMember(resource.data.familyId);
    }

    // Debts Collection - Member cross-reference validation (Parents only can write/delete)
    match /debts/{debtId} {
      allow read: if isAuthenticated() && isFamilyMember(resource.data.familyId);
      allow create: if isAuthenticated() && isParentMember(request.resource.data.familyId);
      allow update: if isAuthenticated() && isParentMember(resource.data.familyId) && isParentMember(request.resource.data.familyId);
      allow delete: if isAuthenticated() && isParentMember(resource.data.familyId);
    }

    // Kid Wallets Collection - Member cross-reference validation (Parents write/delete, members can update/read)
    match /kidWallets/{walletId} {
      allow read: if isAuthenticated() && isFamilyMember(resource.data.familyId);
      allow create: if isAuthenticated() && isParentMember(request.resource.data.familyId);
      allow update: if isAuthenticated() && isFamilyMember(resource.data.familyId) && isFamilyMember(request.resource.data.familyId);
      allow delete: if isAuthenticated() && isParentMember(resource.data.familyId);
    }

    // Saving Goals Collection - Member cross-reference validation (Parents only can write/delete)
    match /savingGoals/{goalId} {
      allow read: if isAuthenticated() && isFamilyMember(resource.data.familyId);
      allow create: if isAuthenticated() && isParentMember(request.resource.data.familyId);
      allow update: if isAuthenticated() && isParentMember(resource.data.familyId) && isParentMember(request.resource.data.familyId);
      allow delete: if isAuthenticated() && isParentMember(resource.data.familyId);
    }

    // Tasks Collection - Member cross-reference validation (Parents create/delete, members update for claiming)
    match /tasks/{taskId} {
      allow read: if isAuthenticated() && isFamilyMember(resource.data.familyId);
      allow create: if isAuthenticated() && isParentMember(request.resource.data.familyId);
      allow update: if isAuthenticated() && isFamilyMember(resource.data.familyId) && isFamilyMember(request.resource.data.familyId);
      allow delete: if isAuthenticated() && isParentMember(resource.data.familyId);
    }
  }
}
