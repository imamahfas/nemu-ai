rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if the user is a member of the given family
    function isFamilyMember(familyId) {
      return isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.members;
    }

    // Users Collection - Read allowed if own profile or belongs to same active family space. Write only own.
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.familyId == resource.data.familyId)
      );
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Families Collection - Member validation
    match /families/{familyId} {
      allow read: if isAuthenticated() && (resource == null || request.auth.uid in resource.data.members);
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.members;
      allow update: if isAuthenticated() && (request.auth.uid in resource.data.members && request.auth.uid in request.resource.data.members);
      allow delete: if isAuthenticated() && request.auth.uid in resource.data.members;
    }

    // Transactions Collection - Member cross-reference validation
    match /transactions/{transactionId} {
      allow read: if isAuthenticated() && isFamilyMember(resource.data.familyId);
      allow create: if isAuthenticated() && isFamilyMember(request.resource.data.familyId);
      allow update: if isAuthenticated() && isFamilyMember(resource.data.familyId) && isFamilyMember(request.resource.data.familyId);
      allow delete: if isAuthenticated() && isFamilyMember(resource.data.familyId);
    }

    // Debts Collection - Member cross-reference validation
    match /debts/{debtId} {
      allow read: if isAuthenticated() && isFamilyMember(resource.data.familyId);
      allow create: if isAuthenticated() && isFamilyMember(request.resource.data.familyId);
      allow update: if isAuthenticated() && isFamilyMember(resource.data.familyId) && isFamilyMember(request.resource.data.familyId);
      allow delete: if isAuthenticated() && isFamilyMember(resource.data.familyId);
    }

    // Kid Wallets Collection - Member cross-reference validation
    match /kidWallets/{walletId} {
      allow read: if isAuthenticated() && isFamilyMember(resource.data.familyId);
      allow create: if isAuthenticated() && isFamilyMember(request.resource.data.familyId);
      allow update: if isAuthenticated() && isFamilyMember(resource.data.familyId) && isFamilyMember(request.resource.data.familyId);
      allow delete: if isAuthenticated() && isFamilyMember(resource.data.familyId);
    }

    // Saving Goals Collection - Member cross-reference validation
    match /savingGoals/{goalId} {
      allow read: if isAuthenticated() && isFamilyMember(resource.data.familyId);
      allow create: if isAuthenticated() && isFamilyMember(request.resource.data.familyId);
      allow update: if isAuthenticated() && isFamilyMember(resource.data.familyId) && isFamilyMember(request.resource.data.familyId);
      allow delete: if isAuthenticated() && isFamilyMember(resource.data.familyId);
    }

    // Tasks Collection - Member cross-reference validation
    match /tasks/{taskId} {
      allow read: if isAuthenticated() && isFamilyMember(resource.data.familyId);
      allow create: if isAuthenticated() && isFamilyMember(request.resource.data.familyId);
      allow update: if isAuthenticated() && isFamilyMember(resource.data.familyId) && isFamilyMember(request.resource.data.familyId);
      allow delete: if isAuthenticated() && isFamilyMember(resource.data.familyId);
    }
  }
}
