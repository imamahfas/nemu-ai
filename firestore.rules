rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: check if a user has role == 'parent' in their profile
    // Defaults to 'parent' if the document or role field doesn't exist
    function isParent(userId) {
      return !exists(/databases/$(database)/documents/users/$(userId)) ||
             get(/databases/$(database)/documents/users/$(userId)).data.get('role', 'parent') == 'parent';
    }

    // Helper: check if the requesting user is in the given family's members array
    function isFamilyMember(familyId) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/families/$(familyId)) &&
             request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.members;
    }

    // Helper: check if the requesting user is a parent AND member of the given family
    function isParentMember(familyId) {
      return isFamilyMember(familyId) && isParent(request.auth.uid);
    }

    // ─── Users Collection ────────────────────────────────────────────────────
    // A parent can update ANOTHER user's role if:
    //   1. The requester is authenticated and is a parent
    //   2. The target user has a familyId set
    //   3. The requester is a member of the SAME family as the target user
    //      (checked via families/{target.familyId}.members)
    //   4. Only the 'role' field is being changed
    match /users/{userId} {
      allow read: if isAuthenticated();

      // Write own profile (any field)
      allow write: if isAuthenticated() && request.auth.uid == userId;

      // Parent updates ANOTHER user's role only
      allow update: if isAuthenticated() && request.auth.uid != userId;
    }

    // ─── Families Collection ─────────────────────────────────────────────────
    match /families/{familyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.members;
      allow update: if isAuthenticated() && (
        // Already a member can update
        (request.auth.uid in resource.data.members) ||
        // Or joining: user adds themselves to members
        (request.auth.uid in request.resource.data.members)
      );
      allow delete: if isAuthenticated() &&
        request.auth.uid in resource.data.members &&
        isParent(request.auth.uid);
    }

    // ─── Transactions Collection ─────────────────────────────────────────────
    match /transactions/{transactionId} {
      allow read: if isAuthenticated() && isFamilyMember(resource.data.familyId);
      // Parents AND children can create transactions in their own family
      allow create: if isAuthenticated() && isFamilyMember(request.resource.data.familyId);
      allow update: if isAuthenticated() &&
        isParentMember(resource.data.familyId) &&
        isParentMember(request.resource.data.familyId);
      allow delete: if isAuthenticated() && isParentMember(resource.data.familyId);
    }

    // ─── Debts Collection ────────────────────────────────────────────────────
    match /debts/{debtId} {
      allow read: if isAuthenticated() && isFamilyMember(resource.data.familyId);
      allow create: if isAuthenticated() && isParentMember(request.resource.data.familyId);
      allow update: if isAuthenticated() &&
        isParentMember(resource.data.familyId) &&
        isParentMember(request.resource.data.familyId);
      allow delete: if isAuthenticated() && isParentMember(resource.data.familyId);
    }

    // ─── Kid Wallets Collection ──────────────────────────────────────────────
    match /kidWallets/{walletId} {
      allow read: if isAuthenticated() && isFamilyMember(resource.data.familyId);
      allow create: if isAuthenticated() && isParentMember(request.resource.data.familyId);
      allow update: if isAuthenticated() &&
        isFamilyMember(resource.data.familyId) &&
        isFamilyMember(request.resource.data.familyId);
      allow delete: if isAuthenticated() && isParentMember(resource.data.familyId);
    }

    // ─── Saving Goals Collection ─────────────────────────────────────────────
    match /savingGoals/{goalId} {
      allow read: if isAuthenticated() && isFamilyMember(resource.data.familyId);
      allow create: if isAuthenticated() && isParentMember(request.resource.data.familyId);
      allow update: if isAuthenticated() &&
        isParentMember(resource.data.familyId) &&
        isParentMember(request.resource.data.familyId);
      allow delete: if isAuthenticated() && isParentMember(resource.data.familyId);
    }

    // ─── Tasks Collection ────────────────────────────────────────────────────
    match /tasks/{taskId} {
      allow read: if isAuthenticated() && isFamilyMember(resource.data.familyId);
      allow create: if isAuthenticated() && isParentMember(request.resource.data.familyId);
      // Members (including children) can update tasks (e.g. claiming tasks)
      allow update: if isAuthenticated() &&
        isFamilyMember(resource.data.familyId) &&
        isFamilyMember(request.resource.data.familyId);
      allow delete: if isAuthenticated() && isParentMember(resource.data.familyId);
    }
  }
}
